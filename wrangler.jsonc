{
  "name": "tancer-kuchtik",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-21",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "WEB_HOST": "kuchtik.tancer.cz",
    "MCP_HOST": "mcp-kuchtik.tancer.cz",
    "PREVIEW": "0"
  },
  "env": {
    "preview": {
      "name": "tancer-kuchtik-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "WEB_HOST": "kuchtik-preview.tancer.cz",
        "MCP_HOST": "mcp-kuchtik-preview.tancer.cz",
        "PREVIEW": "1"
      }
    }
  }
}
