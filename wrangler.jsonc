{
  "name": "tancer-kuchtik",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-21",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "WEB_HOST": "kuchtik.tancer.cz",
    "MCP_HOST": "mcp-kuchtik.tancer.cz",
    "PREVIEW": "0"
  },
  "previews": {
    "vars": {
      "PREVIEW": "1",
      "ACCESS_ISSUER": "https://tancer.cloudflareaccess.com",
      "ACCESS_WEB_AUD": "70eebb3910381c682459a9b7e04c4e62834e8840f7b578f8df8277e45f84ab29"
    }
  }
}
